# SQLite database file (default: data/sums.db)
SUMS_DB_PATH=data/sums.db
# Hostnames allowed to use the dev server remotely, comma-separated
SUMS_DEV_ORIGINS=dev.example.com
# Cookieless product analytics (off when unset)
# SUMS_POSTHOG_KEY=phc_example
# SUMS_POSTHOG_HOST=https://eu.i.posthog.com
# Hosting provider named on the built-in privacy page
# SUMS_HOSTING_PROVIDER=Example Hosting GmbH, Musterstraße 1, 12345 Berlin
# Shared password for the whole installation
# SUMS_PASSWORD=change-me
